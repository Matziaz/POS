{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "types": ["node"],
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "noEmitOnError": true,
    "esModuleInterop": true
  },
  "include": ["src/electron/**/*.ts"]
}