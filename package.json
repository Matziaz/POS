{
  "name": "pos-adaptable",
  "version": "0.1.0",
  "description": "Sistema POS offline-first para micro-comercios",
  "main": "dist/main.js",
  "homepage": "./",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
  "dev": "concurrently \"npm run electron:dev\" \"npm run react-dev\"",
  "react-dev": "vite",
  "electron:dev": "tsc --project tsconfig.electron.json --watch",
  "electron": "electron .",
  "build": "vite build && tsc --project tsconfig.electron.json"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.575.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^2.10.0",
    "sonner": "^2.0.7",
    "sqlite3": "^5.1.6",
    "tailwind-merge": "^3.5.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
